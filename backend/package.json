{
  "name": "@growth/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts | pino-pretty",
    "build": "tsc --noEmit && bun build src/main.ts --target=bun --outdir dist",
    "start": "bun dist/main.js",
    "test": "bun --bun vitest run --passWithNoTests",
    "prisma:generate": "bun --bun node_modules/.bin/prisma generate",
    "prisma:migrate": "bun --bun node_modules/.bin/prisma migrate dev",
    "prisma:deploy": "bun --bun node_modules/.bin/prisma migrate deploy",
    "prisma:studio": "bun --bun node_modules/.bin/prisma studio",
    "auth:generate": "bun --bun node_modules/.bin/auth generate --config src/infrastructure/auth/auth.ts --output src/infrastructure/auth/models/auth.prisma -y",
    "prisma:seed": "bun --bun node_modules/.bin/prisma db seed",
    "openapi": "bun scripts/generate-openapi.ts",
    "dev:progress": "bun --bun scripts/set-progress.ts",
    "dev:daily-reset": "bun --bun scripts/reset-daily-challenge.ts",
    "dev:daily-new": "bun --bun scripts/new-daily-challenge.ts",
    "content:load": "bun prisma/load-content.ts",
    "unlock": "bun scripts/unlock-lessons.ts",
    "seed:demo": "bun --bun scripts/seed-demo.ts",
    "typecheck": "bun --bun node_modules/.bin/prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.13",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "auth": "1.7.13",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "vitest": "5.0.5"
  }
}
