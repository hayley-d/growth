{
  "name": "@growth/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts | pino-pretty",
    "build": "tsc --noEmit && bun build src/main.ts --target=bun --outdir dist",
    "start": "bun dist/main.js",
    "test": "bun --bun vitest run --passWithNoTests",
    "prisma:generate": "bun --bun prisma generate",
    "prisma:migrate": "bun --bun prisma migrate dev",
    "prisma:studio": "bun --bun prisma studio",
    "typecheck": "bun --bun prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "vitest": "5.0.5"
  }
}
