model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now()) @database.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @database.Timestamptz(3)
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?    @database.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  assessmentAttempts AssessmentAttempt[]
  lessonProgress     LessonProgress[]
  mastery            UserMastery[]
  dailyActivity      DailyActivity[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @database.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @database.Timestamptz(3)
  updatedAt      DateTime @updatedAt @database.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @database.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @database.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @database.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @database.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @database.Timestamptz(3)
  createdAt  DateTime @default(now()) @database.Timestamptz(3)
  updatedAt  DateTime @updatedAt @database.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}
