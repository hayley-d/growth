model Lesson {
  id                 String              @id @default(uuid()) @database.Uuid
  unitId             String              @database.Uuid
  title              String
  summary            String
  notePrompt         String?
  kind               LessonKind
  position           Int
  objectives         String[]            @default([])
  isRetired          Boolean             @default(false)
  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contentBlocks      ContentBlock[]
  questions          Question[]          @relation("questionLesson")
  reviewQuestions    Question[]          @relation("questionReviewLesson")
  assessmentAttempts AssessmentAttempt[]
  caseStudies        CaseStudy[]
  progress           LessonProgress[]
  mastery            UserMastery[]
  notes              LessonNote[]

  @@unique([unitId, position])
  @@map("lesson")
}
