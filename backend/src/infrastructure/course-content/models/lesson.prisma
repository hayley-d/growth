model Lesson {
  id            String         @id @default(uuid()) @database.Uuid
  unitId        String         @database.Uuid
  title         String
  summary       String
  kind          LessonKind
  position      Int
  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contentBlocks ContentBlock[]

  @@unique([unitId, position])
  @@map("lesson")
}
