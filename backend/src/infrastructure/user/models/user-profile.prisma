model UserProfile {
  userId             String         @id
  textToSpeech       Boolean        @default(false)
  colourTheme        ColourTheme    @default(default)
  showOnLeaderboard  Boolean        @default(true)
  onboardingComplete Boolean        @default(false)
  learningStyleId    String?        @database.Uuid
  codeLanguageId     String?        @database.Uuid
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningStyle      LearningStyle? @relation(fields: [learningStyleId], references: [id], onDelete: Restrict)
  codeLanguage       CodeLanguage?  @relation(fields: [codeLanguageId], references: [id], onDelete: Restrict)

  @@index([learningStyleId])
  @@index([codeLanguageId])
  @@map("userProfile")
}
