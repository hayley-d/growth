{
  "name": "rebalance",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "docs"
  ],
  "scripts": {
    "dev": "bun run --filter \"@rebalance/backend\" --filter \"@rebalance/frontend\" --filter \"@rebalance/docs\" dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "bun run --filter \"*\" typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
